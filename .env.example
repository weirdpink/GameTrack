# ==============================================================================
# GAMETRACK ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# IGDB API Credentials (REQUIRED)
# These are necessary to search for games and fetch metadata/posters via IGDB.
# Get these from the Twitch Developer Portal.
# ------------------------------------------------------------------------------
IGDB_CLIENT_ID=your_twitch_client_id_here
IGDB_CLIENT_SECRET=your_twitch_client_secret_here

# ------------------------------------------------------------------------------
# Steam Web API Key (OPTIONAL)
# Used to sync your Steam library and track playtime.
# ------------------------------------------------------------------------------
# STEAM_WEB_API_KEY=your_steam_api_key_here

# ------------------------------------------------------------------------------
# Security Configuration (OPTIONAL / REQUIRED FOR REMOTE ACCESS)
# API_TOKEN: When set, every /api request must include `Authorization: Bearer <token>`.
# REQUIRED whenever HOST is not a loopback address (the server refuses to start otherwise).
# Recommended even on loopback when the machine is shared.
# ------------------------------------------------------------------------------
# API_TOKEN=change-me

# ------------------------------------------------------------------------------
# Storage Configuration (OPTIONAL)
# Data directory override (defaults to ./data). Useful for container volumes.
# ------------------------------------------------------------------------------
# GAMETRACK_DATA_DIR=/path/to/data

# ------------------------------------------------------------------------------
# Server Configuration (OPTIONAL)
# ------------------------------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# NODE_ENV=development

# ------------------------------------------------------------------------------
# CORS Configuration (OPTIONAL)
# Additional browser origins allowed for state-changing requests (comma separated).
# The loopback address is always allowed; add your real domain when deploying
# behind a hostname, e.g. https://track.example.com.
# ------------------------------------------------------------------------------
# ALLOWED_ORIGINS=https://track.example.com
